# Đổi tên file này thành .env trước khi chạy

# Cổng chạy server backend
PORT=4000

# Chuỗi bí mật để ký JWT token - BẮT BUỘC đổi khi deploy thật
JWT_SECRET=doi-chuoi-bi-mat-nay-thanh-gia-tri-ngau-nhien-cua-ban

# Thời gian sống của token đăng nhập admin
JWT_EXPIRES_IN=7d

# Cho phép frontend nào gọi API (CORS). Khi dev để mặc định.
FRONTEND_URL=http://192.168.1.27:5173
